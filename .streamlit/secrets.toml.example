# Optional: "Continue with Google" on the sign-in screen (Streamlit's built-in st.login).
# Copy this file to .streamlit/secrets.toml (git-ignored) locally, or paste it into
# Streamlit Community Cloud -> your app -> Settings -> Secrets. Without it, the Google button is hidden
# and email/password + guest sign-in still work.
#
# 1. Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application).
# 2. Authorised redirect URI: https://<your-app>.streamlit.app/oauth2callback  (and http://localhost:8501/oauth2callback)
# 3. Fill in the values below. cookie_secret = any long random string.

[auth]
redirect_uri = "https://self-learning-ai-agent-final-year-project.streamlit.app/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---------------------------------------------------------------------------------------------------------
# Optional: keep accounts in a cloud PostgreSQL database (for example a free Supabase project) so they survive
# restarts of Streamlit Community Cloud. Supabase -> Project settings -> Database -> Connection string (URI).
# Without it, accounts are stored in runs/users.db on the server.
[accounts]
url = "postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------------------------------------------------
# Optional: "Forgot password?" emails. Any SMTP server works. For Gmail, turn on 2-step verification and create
# an App password (Google Account -> Security -> App passwords); use port 587.
# Without it, the dialog says email reset is not set up on this site.
[smtp]
host = "smtp.gmail.com"
port = 587
username = "you@gmail.com"
password = "your-16-character-app-password"
sender = "Self-Learning AI Agent <you@gmail.com>"
app_url = "https://self-learning-ai-agent-final-year-project.streamlit.app/"

# ---------------------------------------------------------------------------------------------------------
# Optional: live webcam video in the Vision Lab on Streamlit Community Cloud. Cloud servers usually need a TURN
# relay for WebRTC. Free option: Cloudflare Calls TURN (dash.cloudflare.com -> Calls -> TURN keys).
# Without it, the Vision Lab still works with camera snapshots, photos and videos.
[webrtc]
cloudflare_key_id = "your-turn-key-id"
cloudflare_api_token = "your-turn-api-token"
# or give your own servers instead:
# ice_servers = [{ urls = ["turn:turn.example.com:3478"], username = "user", credential = "pass" }]
